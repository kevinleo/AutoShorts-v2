# Copy this file to `.env` — the pipeline loads `.env` automatically at startup.
# Real environment variables always win over the values in this file.

# ── LLM endpoints (OpenAI-compatible, e.g. llama.cpp) ──────────────────
# Writer/author model (required). llama.cpp: `llama-server -m model.gguf --port 8888`
LLM_AUTHOR_URL=http://127.0.0.1:8888/v1
# Optional second evaluator (cross-check scoring). Falls back to the author
# model when unset — the gate still runs (min(ent,edu) >= 3).
LLM_CPU_EVALUATOR_URL=http://127.0.0.1:8085/v1
# NPU/GPU backup evaluator (used only when set)
# NPU_EVALUATOR_URL=

# ── Video generation ────────────────────────────────────────────────────
# ltx mode needs a video factory (LTX-Video 2B T2V + /thumb). Set empty or
# use --video-gen local for FFmpeg-only slides (no external box required).
# VIDEO_FACTORY_URL=http://192.168.1.20:8090
# LTX_W=512
# LTX_H=512
# LTX_STEPS=24
# LTX_FRAMES=49

# ── Knowledge base embeddings (optional, $0) ────────────────────────────
# Local llama.cpp embedder for the hybrid (BM25 + vector) search:
#   llama-server -m nomic-embed-text-v1.5.Q8_0.gguf --embeddings --port 8086
# Without it, knowledge_base.py search falls back to BM25 keyword search only.
# EMBED_URL=http://127.0.0.1:8086/v1/embeddings

# ── OAuth (upload / viewer taste) ───────────────────────────────────────
# Put credentials.json (OAuth client) and token.json (refresh token) next to
# this file, or point the env vars at them.
# VIEWER_TOKEN_FILE=./viewer_token.json
# VIEWER_CLIENT_FILE=./credentials.json
# VIEWER_SECRETS_FILE=./client_secrets.json
# VIEWER_CLIENT_ID=your-number.apps.googleusercontent.com

# ── Optional paid fallback (MiniMax H3) — NOT needed, the pipeline is $0 ──
# MINIMAX_API_KEY=
# H3_MODEL=
